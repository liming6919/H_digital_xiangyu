<?xml version="1.0"?>
<launch>
    <!-- 电机控制节点 -->
    <node name="ymbot_joint_eu_ros_control" pkg="ymbot_devices_driver" type="ymbot_joint_eu_ros_control" output="screen">
        <!-- 控制频率 (Hz) - 降低频率以减少CPU占用 -->
        <param name="control_frequency" value="30"/>
        
        <!-- 设备索引 -->
        <param name="device_index" value="0"/>
        
        <!-- 通道 -->
        <param name="channel" value="0"/>
        
        <!-- CAN设备组数 -->
        <param name="n_motor_group" value="3"/>
        
        <!-- 电机ID列表 - 可以根据需要修改 -->
        <rosparam param="motor_ids">[31, 32, 33, 34, 35, 41, 42, 43, 44, 45]</rosparam>
        
        <!-- ROS日志级别 -->
        <env name="ROSCONSOLE_CONFIG_FILE" value="$(find ymbot_devices_driver)/config/rosconsole.conf"/>
    </node>
    
    <!-- 可选：启动rqt_plot来监控关节状态 -->
    <!-- <node name="rqt_plot" pkg="rqt_plot" type="rqt_plot" args="/joint_states/position[0] /joint_states/position[1] /joint_states/position[2] /joint_states/position[3] /joint_states/position[4]"/> -->
    
    <!-- 可选：启动测试节点 -->
    <!-- <node name="motor_control_tester" pkg="ymbot_devices_driver" type="test_motor_control.py" output="screen" args="interactive"/> -->
</launch>
